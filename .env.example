# Copy this file to .env and fill in your own values.
# .env is gitignored and never committed. On GitHub Actions these are
# provided as repository secrets instead (see .github/workflows/daily_scrape.yml).

# OpenAI API key used by scorer.py to score jobs.
OPENAI_API_KEY=sk-...

# Gmail account that sends the digest, plus a Gmail App Password
# (NOT your normal password — generate one at https://myaccount.google.com/apppasswords).
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where the digest gets sent (can be the same as GMAIL_ADDRESS).
EMAIL_RECIPIENT=you@gmail.com

# Turso (libSQL) database — persists jobs/scores across runs.
# Create with: turso db create job-finder
#   URL:   turso db show job-finder --url
#   Token: turso db tokens create job-finder
# If these are unset, the app falls back to a local jobs.db file.
TURSO_DATABASE_URL=libsql://job-finder-you.turso.io
TURSO_AUTH_TOKEN=ey...
